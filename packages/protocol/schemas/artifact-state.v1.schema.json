{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-artifact-runtime.local/schemas/artifact-state.v1.schema.json",
  "title": "Artifact State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_id",
    "version",
    "view",
    "props"
  ],
  "properties": {
    "schema": {
      "const": "artifact.state.v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "view": {
      "type": "string",
      "minLength": 1
    },
    "props": {
      "type": "object"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "default": []
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      },
      "default": []
    },
    "metadata": {
      "type": "object",
      "default": {}
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "asset_id",
        "type"
      ],
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "hash": {
          "type": "string"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "side_effect": {
          "type": "boolean",
          "default": false
        },
        "requires_confirmation": {
          "type": "boolean",
          "default": false
        },
        "required_permission": {
          "type": "string"
        }
      }
    }
  }
}

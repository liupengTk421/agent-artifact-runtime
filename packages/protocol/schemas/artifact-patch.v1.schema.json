{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-artifact-runtime.local/schemas/artifact-patch.v1.schema.json",
  "title": "Artifact Patch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_id",
    "base_version",
    "ops"
  ],
  "properties": {
    "schema": {
      "const": "artifact.patch.v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "base_version": {
      "type": "integer",
      "minimum": 1
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/op"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "op": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "path"
      ],
      "properties": {
        "op": {
          "enum": [
            "add",
            "remove",
            "replace",
            "test"
          ]
        },
        "path": {
          "type": "string"
        },
        "value": {},
        "from": {
          "type": "string"
        }
      }
    }
  }
}
